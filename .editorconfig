root = true

# ---------------------------------------------------------------------------------------------
# Shared whitespace baseline (all files).
# ---------------------------------------------------------------------------------------------
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json,proto}]
indent_size = 2

# The walker (C/C++) is Google/2-space style; the actual formatter is clang-format (.clang-format).
# This block only sets the editor whitespace baseline — keep it consistent with .clang-format.
[*.{cpp,cc,cxx,c,h,hpp,hxx}]
indent_size = 2

[*.{ps1,psm1}]
indent_size = 4
end_of_line = crlf

[Makefile]
indent_style = tab

# ---------------------------------------------------------------------------------------------
# Byte-exact tool output (mirrors the `-text` carve-outs in .gitattributes). These files are
# committed exactly as the tool wrote them, with no trailing newline. Without this override,
# EditorConfig's global insert_final_newline=true (line 9) makes any editor silently append a
# newline on save, producing a spurious diff against the committed byte-exact blob.
[{artifacts/**,host/tests/**/fixtures/**,data/wire_descriptors.pb}]
insert_final_newline = false
trim_trailing_whitespace = false

# ---------------------------------------------------------------------------------------------
# C# — the ruleset `dotnet format` enforces (formatting + house style). TreatWarningsAsErrors +
# EnforceCodeStyleInBuild are on, and these rules are set to `error`, so a style deviation fails
# the build; `dotnet format` fixes the fixable ones. The rules encode the conventions the code
# already follows uniformly (file-scoped namespaces, Allman braces, System-first usings).
# ---------------------------------------------------------------------------------------------
[*.{cs,csproj,sln,props,targets}]
indent_size = 4

[*.cs]
# Whole-document formatting (spacing / newlines / indentation) — build-enforced, auto-fixable.
dotnet_diagnostic.IDE0055.severity = error

# using directives: System groups first, placed outside the namespace, separated into groups.
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = true
csharp_using_directive_placement = outside_namespace:error
dotnet_diagnostic.IDE0065.severity = error

# File-scoped namespaces (namespace X;) — the code uses these everywhere.
csharp_style_namespace_declarations = file_scoped:error

# Allman braces: every brace on its own new line.
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true

# Indentation.
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_labels = one_less_than_current

# Spacing.
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_after_colon_in_inheritance_clause = true

# Newline preservation.
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = true

# `this.` is not used in this codebase.
dotnet_style_qualification_for_field = false:error
dotnet_style_qualification_for_property = false:error
dotnet_style_qualification_for_method = false:error
dotnet_style_qualification_for_event = false:error

# Language keywords for types (int over Int32) — build-enforced.
dotnet_style_predefined_type_for_locals_parameters_members = true:error
dotnet_style_predefined_type_for_member_access = true:error
dotnet_diagnostic.IDE0049.severity = error
