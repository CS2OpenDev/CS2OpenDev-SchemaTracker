<?xml version="1.0" encoding="utf-8"?>
<!--
  Release-bundle publish profile: a SELF-CONTAINED, single-platform host (bundles its own .NET
  runtime — the target needs no dotnet install). One bundle per RID; pass the RID on the command line:

    dotnet publish host/src/Cs2SchemaTracker.Host -p:PublishProfile=Bundle \
           -p:RuntimeIdentifier=win-x64      # -> dist/cs2-schema-tracker-<version>-win-x64.zip
    dotnet publish host/src/Cs2SchemaTracker.Host -p:PublishProfile=Bundle \
           -p:RuntimeIdentifier=linux-x64    # -> dist/cs2-schema-tracker-<version>-linux-x64.tar.gz

  The <version> is driven automatically by the Nerdbank.GitVersioning PackageReference (MSBuild
  $(Version) == the SemVer2 string) — no -p:BundleVersion needed; pass one only to override.

  BundleRelease=true triggers the AssembleBundle target (bundle.targets), which verify-natives-gates
  the RID's platform, stages that platform's natives + the inventory + a bundle appsettings.json next
  to the apphost, and packages it (zip on Windows, exec-bit-preserving tar.gz on Linux). Build each
  RID's bundle on its own OS (the release matrix does exactly that).

  NOT trimmed: the host serializes JSON by reflection (System.Text.Json) and pulls in SteamKit2, both
  of which the trimmer breaks under TreatWarningsAsErrors. Self-contained already gives portability.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <PublishProtocol>FileSystem</PublishProtocol>
    <!-- RuntimeIdentifier is supplied per invocation (-p:RuntimeIdentifier=win-x64|linux-x64). -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <UseAppHost>true</UseAppHost>
    <BundleRelease>true</BundleRelease>
  </PropertyGroup>
</Project>
