{
  "Cs2SchemaTracker": {
    // External root for acquired CS2 binaries; convention <root>/<build>/<platform>/. Env override: CS2_BINARIES_ROOT. Empty = use the in-repo cache/binaries/<build>/<platform>/
    "BinariesRoot": "",

    // Root of the native per-era walker binaries; holds one <platform>/ subdir per target (e.g. windows-x86_64/, linux-x86_64/) with per-era walker exes inside (named by era id, .exe on windows). Env override: CS2_WALKER_ERAS_ROOT. Empty = the natives/ dir next to the exe
    "NativesRoot": "",

    // Explicit single walker-binary path; bypasses per-era selection (dev/test escape hatch). Env override: CS2_WALKER_BIN. Empty = era selection / the walker/build default.
    "WalkerBin": "",

    // Path to the single-source assets inventory + era catalog. No env override key. Empty = repo-root data/cs2-assets-inventory.json.
    "InventoryPath": "",

    // Default off-repo output root for non-committed extract runs; convention <root>/<build>/<platform>/. No env override key. Empty = built-in ./extract-out/.
    "ExtractOutRoot": "",

    // Default target platform for the extract command when --platform is omitted. No env override key. Empty = require explicit --platform.
    "ExtractPlatform": ""
  }
}
