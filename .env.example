# CS2-Schema-Tracker — local environment overrides.
#
# Copy to `.env` (gitignored) and set values. The `.env` file is read by:
#   - scripts/bootstrap-windows.ps1 (Stage B reads WSL_USERNAME / WSL_PASSWORD)
#   - the host CLI, eventually, for any operator-supplied configuration
#
# Do NOT commit `.env`. It's gitignored by default at the repo root.
# Treat every value here as a secret: not in issues, logs, or screenshots.

# --- WSL2 Ubuntu provisioning (Stage B) -------------------------------------------------
# If both keys are present, Stage B installs Ubuntu-22.04 with --no-launch and creates
# this UNIX user via root-mode bash (chpasswd reads the password from stdin so it never
# appears in any /proc/<pid>/cmdline). Passwordless sudo is configured for this user, and
# they become the default WSL user. If either key is missing, Stage B falls back to the
# interactive first-time setup flow.
WSL_USERNAME=
WSL_PASSWORD=

# --- Steam credentials (historical builds only) -----------------------------------------
# CS2 is free-to-play, so `acquire` logs on anonymously by default and that is enough for
# the CURRENT public build. Anonymous PICS only exposes the current manifest, so a
# historical build can't be resolved that way — it needs an account that owns CS2.
# `acquire --auth --from-manifest <spec.json>` reads these two keys from the environment
# (this file included). First authenticated run wants a --guard-code; the Steam Guard
# session is cached afterwards, so later runs are non-interactive. See docs/HOST.md.
STEAM_USERNAME=
STEAM_PASSWORD=
